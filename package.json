{
  "name": "vng-personal-site",
  "private": true,
  "description": "Personal site of Vighnesh Natarajan Ganesh. Static; the bundle in assets/js is committed so GitHub Pages needs no build.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=esm --target=es2020 --outfile=assets/js/app.js",
    "watch": "esbuild src/main.js --bundle --format=esm --target=es2020 --outfile=assets/js/app.js --watch",
    "serve": "python -m http.server 8080"
  },
  "dependencies": { "gsap": "^3.15.1", "lenis": "^1.3.27", "three": "^0.187.0" },
  "devDependencies": { "esbuild": "^0.28.2" }
}
